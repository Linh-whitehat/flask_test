</div>

<div class="grid grid-cols-2 gap-4">
    <textarea id="inputText" class="border p-3 rounded h-40" placeholder="Nhập văn bản..."></textarea>
    <textarea id="outputText" class="border p-3 rounded h-40 bg-gray-50" placeholder="Kết quả..." readonly></textarea>
</div>

<div class="flex justify-between mt-4">
    <button onclick="translateText()" class="bg-blue-500 text-white px-4 py-2 rounded">Dịch</button>
    <button onclick="copyText()" class="bg-green-500 text-white px-4 py-2 rounded">Copy</button>
</div>

</div><script>
async function translateText() {
    const text = document.getElementById("inputText").value;
    const src = document.getElementById("src").value;
    const dest = document.getElementById("dest").value;

    const res = await fetch("/translate", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({ text, src, dest })
    });

    const data = await res.json();
    document.getElementById("outputText").value = data.translated;
}

function copyText() {
    const output = document.getElementById("outputText");
    output.select();
    document.execCommand("copy");
}
</script></body>
</html>


