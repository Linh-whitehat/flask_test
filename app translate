from flask import Flask, render_template, request, jsonify from googletrans import Translator

app = Flask(name) translator = Translator()

@app.route("/") def index(): return render_template("index.html")

@app.route("/translate", methods=["POST"]) def translate(): data = request.get_json() text = data.get("text") src = data.get("src") dest = data.get("dest")

result = translator.translate(text, src=src, dest=dest)
return jsonify({"translated": result.text})

if name == "main": app.run(debug=True)

