            <div class="item" data-meaning="{{ m }}" onclick="selectRight(this)">
                {{ m }}
            </div>
            {% endfor %}
        </div>
    </div>
</div>


<script>
let selectedLeft = null;
let selectedRight = null;

const pairs = {{ pairs | tojson }}

function selectLeft(el) {
    if (selectedLeft) selectedLeft.classList.remove("selected");
    selectedLeft = el;
    el.classList.add("selected");
    check();
}

function selectRight(el) {
    if (selectedRight) selectedRight.classList.remove("selected");
    selectedRight = el;
    el.classList.add("selected");
    check();
}

function check() {
    if (selectedLeft && selectedRight) {

        let h = selectedLeft.dataset.hanzi;
        let m = selectedRight.dataset.meaning;

        console.log("Check:", h, m, pairs[h]);

        // 👉 nếu đã đúng rồi thì bỏ qua
        if (selectedLeft.classList.contains("correct") ||
            selectedRight.classList.contains("correct")) {
            return;
        }

        if (pairs[h] === m) {

            // ✅ đúng → xanh + khóa
            selectedLeft.classList.add("correct");
            selectedRight.classList.add("correct");

            selectedLeft.onclick = null;
            selectedRight.onclick = null;

        } else {

            // ❌ sai → đỏ tạm
            selectedLeft.classList.add("wrong");
            selectedRight.classList.add("wrong");

            setTimeout(() => {
                selectedLeft.classList.remove("wrong");
                selectedRight.classList.remove("wrong");
            }, 500);
        }

        // 👉 reset chọn (KHÔNG xóa correct)
        setTimeout(() => {
            selectedLeft.classList.remove("selected");
            selectedRight.classList.remove("selected");
            selectedLeft = null;
            selectedRight = null;
        }, 200);
    }
}
</script>

</body>
</html>
