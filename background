
.btn-submit, .btn-next {
    padding: 10px 18px;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-submit {
    background: #4CAF50;
    margin-right: 10px;
}

.btn-next {
    background: #2196F3;
}

.btn-submit:hover {
    background: #43a047;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.3);
}

.btn-next:hover {
    background: #1976d2;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.3);
}

.btn-submit:active,
.btn-next:active {
    transform: scale(0.95);
    box-shadow: none;
}

<script>
let selectedLeft = null;
let selectedRight = null;

const pairs = {{ pairs | tojson }};
let answers = {};

function selectLeft(el) {
    if (selectedLeft) selectedLeft.classList.remove("selected");
    selectedLeft = el;
    el.classList.add("selected");
    check();
}

function selectRight(el) {
    if (selectedRight) selectedRight.classList.remove("selected");
    selectedRight = el;
    el.classList.add("selected");
    check();
}

function check() {
    if (selectedLeft && selectedRight) {

        let h = selectedLeft.dataset.hanzi;
        let m = selectedRight.dataset.meaning;

        if (pairs[h] === m) {

            selectedLeft.classList.add("correct");
            selectedRight.classList.add("correct");

            selectedLeft.onclick = null;
            selectedRight.onclick = null;

            matched[h] = m;

        } else {
            selectedLeft.classList.add("wrong");
            selectedRight.classList.add("wrong");

            setTimeout(() => {
                selectedLeft.classList.remove("wrong");
                selectedRight.classList.remove("wrong");
            }, 500);
        }

        setTimeout(() => {
            selectedLeft.classList.remove("selected");
            selectedRight.classList.remove("selected");
            selectedLeft = null;
            selectedRight = null;
        }, 200);
    }
}

function submitGame() {
    if (Object.keys(matched).length < Object.keys(pairs).length) {
        alert("⚠️ Bạn chưa nối hết!");
        return;
    }

    let total = Object.keys(pairs).length;
    let correct = 0;

    for (let key in pairs) {
        if (matched[key] === pairs[key]) {
            correct++;
        }
    }

    let result = document.getElementById("result");

    if (correct === total) {
        result.innerHTML = "🎉 Hoàn hảo! " + correct + "/" + total;
        result.style.color = "green";
    } else {
        result.innerHTML = "😅 Đúng " + correct + "/" + total;
        result.style.color = "orange";
    }
}

function nextGame() {
    window.location.href = "/game";
}
</script>


